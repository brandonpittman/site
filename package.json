{
	"name": "brandon-pittman",
	"description": "Brandon Pittman's personal site",
	"version": "2.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/copy-cms.js && node scripts/set-cms-config.js && vite build",
		"preview": "vite preview",
		"prepare": "node scripts/copy-cms.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "prettier --write .",
		"fmt.check": "prettier --check .",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@sveltia/cms": "^0.166.1",
		"@types/node": "^22",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.46.1",
		"vite": "^8.0.12",
		"vite-plugin-devtools-json": "^1.0.0",
		"wrangler": "^4.118.0"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"highlight.js": "^11.11.1",
		"marked": "^17.0.0",
		"marked-highlight": "^2.2.3",
		"zod": "^4.1.12"
	},
	"allowScripts": {
		"esbuild": true,
		"sharp": true,
		"workerd": true
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
